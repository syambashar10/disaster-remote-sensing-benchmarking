{
  "dataset_id": "xbd_kaggle",
  "dataset_name": "xBD / xView2 Kaggle Train Split",
  "dataset_path": "datasets/xbd_raw",
  "task_type": [
    "building_damage_assessment",
    "object_detection",
    "instance_segmentation",
    "change_analysis"
  ],
  "raw_annotation_type": "polygon",
  "image_format": "png",
  "annotation_format": "json_wkt",
  "split_structure": {
    "train_images": "images",
    "train_labels": "labels"
  },
  "expected_image_size": {
    "width": 1024,
    "height": 1024
  },
  "feature_type": "building",
  "damage_classes": [
    "no-damage",
    "minor-damage",
    "major-damage",
    "destroyed",
    "un-classified",
    "no_damage_label"
  ],
  "recommended_formats": [
    "coco_detection",
    "coco_instance_segmentation",
    "yolo_detection",
    "yolo_segmentation",
    "geojson",
    "statistics"
  ],
  "unsupported_formats": [
    "semantic_flood_mask",
    "native_raster_mask"
  ],
  "loader_name": "JsonPolygonLoader",
  "status": "configured_loadable_needs_label_review",
  "pairing_checks": [
    {
      "name": "xbd_kaggle_image_label_pairing",
      "reference_root": "images",
      "reference_extensions": [
        ".png"
      ],
      "candidate_roots": {
        "labels": "labels"
      },
      "candidate_extensions": {
        "labels": [
          ".json"
        ]
      },
      "max_examples": 20
    }
  ],
  "data_family": "json_polygon_annotations",
  "human_review_required": true,
  "json_polygon_schema": {
    "image_folder": "images",
    "label_folder": "labels",
    "image_extensions": [
      ".png"
    ],
    "label_extensions": [
      ".json"
    ],
    "feature_container": "features.xy",
    "wkt_key": "wkt",
    "properties_key": "properties",
    "class_key": "feature_type",
    "damage_key": "subtype",
    "uid_key": "uid"
  },
  "lossy_or_derived_formats": []
}
